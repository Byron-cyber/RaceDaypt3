@model List<EventDto>
@{ ViewData["Title"] = "My events"; }

<div class="rd-page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div><h1>My events</h1><p>Create, edit and manage the events you organise.</p></div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New event</a>
</div>

@if (!Model.Any())
{
    <div class="rd-empty">
        <i class="bi bi-flag"></i>
        <h2>No events yet</h2>
        <p>Create your first event to get started.</p>
        <a class="btn btn-primary" asp-action="Create">Create an event</a>
    </div>
}
else
{
    <div class="card rd-table-card">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead><tr><th>Event</th><th>Date</th><th>Type</th><th>Distance</th><th>Status</th><th>Enrolled</th><th class="text-end">Manage</th></tr></thead>
                <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><strong>@e.Title</strong><div class="rd-meta">@e.Location, @e.City</div></td>
                        <td>@Format.ShortDate(e.EventDate)</td>
                        <td>@Format.TypeEmoji(e.EventType) @e.EventType</td>
                        <td>@Format.Distance(e.DistanceKm)</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td>@(e.EnrolmentCount ?? 0)</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@e.EventId" title="Edit event"><i class="bi bi-pencil"></i> Edit</a>
                            <a class="btn btn-outline-primary btn-sm" asp-controller="OrganiserCategories" asp-action="Manage" asp-route-eventId="@e.EventId">Categories</a>
                            <a class="btn btn-outline-primary btn-sm" asp-controller="OrganiserEnrolments" asp-action="Manage" asp-route-eventId="@e.EventId">Enrolments</a>
                            <a class="btn btn-outline-primary btn-sm" asp-controller="OrganiserResults" asp-action="Manage" asp-route-eventId="@e.EventId">Results</a>
                            @if (e.Status is not ("Cancelled" or "Completed"))
                            {
                                <form asp-action="Cancel" asp-route-id="@e.EventId" method="post" class="d-inline" data-confirm="Cancel &quot;@e.Title&quot;? Participants will no longer be able to enrol.">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Cancel event"><i class="bi bi-x-circle"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
