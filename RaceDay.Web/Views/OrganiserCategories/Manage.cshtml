@using Microsoft.AspNetCore.Mvc.Rendering
@model CategoryManageViewModel
@{
    var genderItems = Lookups.GenderRestrictions.Select(g => new SelectListItem(g, g)).ToList();
    var ev = Model.Event;
    ViewData["Title"] = "Categories";
}

<div class="rd-page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h1>Categories</h1>
        <p><strong>@ev.Title</strong> · @Format.ShortDate(ev.EventDate)</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="OrganiserEvents" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to events</a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        @if (!ev.Categories.Any())
        {
            <div class="rd-empty"><i class="bi bi-diagram-3"></i><h2>No categories yet</h2><p>Add the first one using the form. Think distances (10 km, 21 km) or age groups (Under 20, Masters).</p></div>
        }
        else
        {
            <div class="card rd-table-card">
                <div class="table-responsive">
                    <table class="table rd-table align-middle mb-0">
                        <thead><tr><th>Category</th><th>Distance</th><th>Fee</th><th>Ages</th><th>Limit</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var c in ev.Categories)
                        {
                            <tr>
                                <td><strong>@c.Name</strong>@(c.GenderRestriction == "None" ? "" : $" ({c.GenderRestriction})")</td>
                                <td>@Format.Distance(c.DistanceKm)</td>
                                <td>@Format.Money(c.EntryFee)</td>
                                <td>@(c.AgeMin is null && c.AgeMax is null ? "All" : (c.AgeMin?.ToString() ?? "0") + (c.AgeMax is null ? "+" : "–" + c.AgeMax))</td>
                                <td>@(c.MaxEntries?.ToString() ?? "None")</td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-eventId="@ev.EventId" asp-route-id="@c.CategoryId"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-eventId="@ev.EventId" asp-route-id="@c.CategoryId" method="post" class="d-inline" data-confirm="Delete the category &quot;@c.Name&quot;?">
                                        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card rd-form-card">
            <h3>Add a category</h3>
            <form asp-action="Create" asp-route-eventId="@ev.EventId" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="NewCategory.Name" class="form-label"></label>
                        <input asp-for="NewCategory.Name" class="form-control" placeholder="e.g. 10km Road Race" />
                        <span asp-validation-for="NewCategory.Name" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.DistanceKm" class="form-label"></label>
                        <input asp-for="NewCategory.DistanceKm" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="NewCategory.DistanceKm" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.EntryFee" class="form-label"></label>
                        <input asp-for="NewCategory.EntryFee" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="NewCategory.EntryFee" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.AgeMin" class="form-label"></label>
                        <input asp-for="NewCategory.AgeMin" class="form-control" type="number" min="0" max="120" />
                        <span asp-validation-for="NewCategory.AgeMin" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.AgeMax" class="form-label"></label>
                        <input asp-for="NewCategory.AgeMax" class="form-control" type="number" min="0" max="120" />
                        <span asp-validation-for="NewCategory.AgeMax" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.GenderRestriction" class="form-label"></label>
                        <select asp-for="NewCategory.GenderRestriction" asp-items="genderItems" class="form-select"></select>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.MaxEntries" class="form-label"></label>
                        <input asp-for="NewCategory.MaxEntries" class="form-control" type="number" min="1" placeholder="No limit" />
                        <span asp-validation-for="NewCategory.MaxEntries" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3 w-100"><i class="bi bi-plus-lg"></i> Add category</button>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
