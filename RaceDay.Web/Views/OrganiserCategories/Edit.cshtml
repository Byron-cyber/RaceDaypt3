@using Microsoft.AspNetCore.Mvc.Rendering
@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
    var genderItems = Lookups.GenderRestrictions.Select(g => new SelectListItem(g, g)).ToList();
}

<div class="rd-page-header">
    <h1>Edit category</h1>
    <p>@ViewData["EventTitle"]</p>
</div>

<div class="card rd-form-card" style="max-width:720px">
    <form asp-action="Edit" asp-route-eventId="@Model.EventId" asp-route-id="@Model.CategoryId" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="EntryFee" class="form-label"></label>
                <input asp-for="EntryFee" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="EntryFee" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="AgeMin" class="form-label"></label>
                <input asp-for="AgeMin" class="form-control" type="number" min="0" max="120" />
                <span asp-validation-for="AgeMin" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="AgeMax" class="form-label"></label>
                <input asp-for="AgeMax" class="form-control" type="number" min="0" max="120" />
                <span asp-validation-for="AgeMax" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="GenderRestriction" class="form-label"></label>
                <select asp-for="GenderRestriction" asp-items="genderItems" class="form-select"></select>
            </div>
            <div class="col-sm-6">
                <label asp-for="MaxEntries" class="form-label"></label>
                <input asp-for="MaxEntries" class="form-control" type="number" min="1" placeholder="No limit" />
                <span asp-validation-for="MaxEntries" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save changes</button>
            <a class="btn btn-outline-secondary" asp-action="Manage" asp-route-eventId="@Model.EventId">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
