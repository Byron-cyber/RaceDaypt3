@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var authenticated = User.Identity?.IsAuthenticated == true;
    var isOrganiser = User.IsInRole("Organiser");
    var isParticipant = User.IsInRole("Participant");
    string Active(params string[] names) => names.Contains(controller) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? t + " | RaceDay" : "RaceDay")</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
            <div class="container">
                <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo.svg" alt="" width="34" height="34" />
                    <span>RACE<span class="rd-brand-accent">DAY</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (!authenticated)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Home</a></li>
                        }
                        else if (isOrganiser)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("OrganiserEvents")" asp-controller="OrganiserEvents" asp-action="Index"><i class="bi bi-flag"></i> Events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("OrganiserCategories")" asp-controller="OrganiserCategories" asp-action="Index"><i class="bi bi-diagram-3"></i> Categories</a></li>
                            <li class="nav-item"><a class="nav-link @Active("OrganiserEnrolments")" asp-controller="OrganiserEnrolments" asp-action="Index"><i class="bi bi-people"></i> Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @Active("OrganiserResults")" asp-controller="OrganiserResults" asp-action="Index"><i class="bi bi-stopwatch"></i> Results</a></li>
                        }
                        else if (isParticipant)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Events")" asp-controller="Events" asp-action="Index"><i class="bi bi-calendar-event"></i> Events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("MyEnrolments")" asp-controller="MyEnrolments" asp-action="Index"><i class="bi bi-ticket-perforated"></i> My enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @Active("MyResults")" asp-controller="MyResults" asp-action="Index"><i class="bi bi-trophy"></i> My results</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (authenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index">
                                    <span class="rd-avatar-sm">@Format.Initials(User.Identity?.Name?.Split(' ').FirstOrDefault() ?? "", User.Identity?.Name?.Split(' ').LastOrDefault() ?? "")</span>
                                    @User.Identity?.Name
                                    <span class="rd-role-pill">@(isOrganiser ? "Organiser" : "Participant")</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Account")" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="rd-main">
        <div class="container">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show rd-alert" role="alert">
                    <i class="bi bi-check-circle-fill"></i> @success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show rd-alert" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i> @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span class="rd-brand-small">RACE<span class="rd-brand-accent">DAY</span> &middot; Run. Walk. Ride. Finish.</span>
            <span>&copy; @DateTime.Now.Year RaceDay</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
