@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<div class="rd-page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div><h1>Organiser dashboard</h1><p>A snapshot of your events and entries.</p></div>
    <a class="btn btn-primary" asp-controller="OrganiserEvents" asp-action="Create"><i class="bi bi-plus-lg"></i> New event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4"><div class="card rd-stat"><div class="rd-stat-number">@Model.TotalEvents</div><div class="rd-stat-label">Events created</div></div></div>
    <div class="col-sm-6 col-lg-4"><div class="card rd-stat rd-stat-lime"><div class="rd-stat-number">@Model.PublishedEvents</div><div class="rd-stat-label">Published events</div></div></div>
    <div class="col-sm-12 col-lg-4"><div class="card rd-stat rd-stat-navy"><div class="rd-stat-number">@Model.TotalEnrolments</div><div class="rd-stat-label">Total enrolments</div></div></div>
</div>

@if (!Model.Events.Any())
{
    <div class="rd-empty">
        <i class="bi bi-flag"></i>
        <h2>Create your first event</h2>
        <p>Set up an event, add its categories and open it for enrolment.</p>
        <a class="btn btn-primary" asp-controller="OrganiserEvents" asp-action="Create">Create an event</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card rd-table-card">
                <div class="px-3 pt-3"><h3>Enrolments per event</h3></div>
                <div class="table-responsive">
                    <table class="table rd-table align-middle mb-0">
                        <thead><tr><th>Event</th><th>Date</th><th>Status</th><th>Enrolments</th><th></th></tr></thead>
                        <tbody>
                        @{ var maxCount = Math.Max(1, Model.Events.Max(x => x.EnrolmentCount ?? 0)); }
                        @foreach (var e in Model.Events.OrderBy(x => x.EventDate))
                        {
                            var count = e.EnrolmentCount ?? 0;
                            var scale = e.MaxParticipants ?? maxCount;
                            var pct = Math.Min(100, (int)Math.Round(100.0 * count / Math.Max(1, scale)));
                            <tr>
                                <td><strong>@e.Title</strong><div class="rd-meta">@e.EventType · @e.City</div></td>
                                <td>@Format.ShortDate(e.EventDate)</td>
                                <td><partial name="_StatusBadge" model="e.Status" /></td>
                                <td style="min-width:140px">
                                    <strong>@count</strong>@(e.MaxParticipants is null ? "" : " / " + e.MaxParticipants)
                                    <div class="rd-bar mt-1"><span style="width:@pct%"></span></div>
                                </td>
                                <td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-controller="OrganiserEnrolments" asp-action="Manage" asp-route-eventId="@e.EventId">View</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card rd-form-card">
                <h3>Upcoming dates</h3>
                @if (!Model.Upcoming.Any())
                {
                    <p class="rd-meta mb-0">No upcoming events. Time to plan the next one!</p>
                }
                @foreach (var e in Model.Upcoming)
                {
                    <div class="rd-upcoming">
                        <div class="rd-date-block"><strong>@Format.Day(e.EventDate)</strong>@Format.Month(e.EventDate)</div>
                        <div class="flex-grow-1">
                            <div><strong>@e.Title</strong></div>
                            <div class="rd-meta">@e.City · @(e.EnrolmentCount ?? 0) enrolled</div>
                        </div>
                        <partial name="_StatusBadge" model="e.Status" />
                    </div>
                }
            </div>
        </div>
    </div>
}
